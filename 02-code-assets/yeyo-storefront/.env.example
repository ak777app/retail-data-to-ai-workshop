# Copy to .env and edit. Names match Module-11 (streaming) and Module-12 (storefront).
PROJECT_ID="YOUR_PROJECT_ID"
LOCATION="us-central1"

BQ_DATASET="capstone_ds"
PUBSUB_TOPIC="yeyo-orders"
BQ_ONLINE_ORDERS_TABLE="online_orders"
BQ_MARKETPLACE_ORDERS_TABLE="marketplace_orders"
BQ_INSTORE_ORDERS_TABLE="instore_orders"

# Catalog: sample (bundled CSVs) | bigquery | auto (BigQuery, else sample)
CATALOG_SOURCE="sample"
BQ_PRODUCT_MASTER_TABLE="product_master"
BQ_MARKETPLACE_SELLERS_TABLE="marketplace_seller_master"
BQ_MARKETPLACE_LISTINGS_TABLE="marketplace_listings"

# Publishing: auto (Pub/Sub, fall back to BigQuery direct) | pubsub | bigquery | local
PUBLISH_MODE="auto"

# Order spike (trial-friendly defaults)
SPIKE_DEFAULT_ORDERS=200
SPIKE_MAX_ORDERS=2000
SPIKE_DEFAULT_DURATION_SECONDS=60
SPIKE_MAX_DURATION_SECONDS=600
